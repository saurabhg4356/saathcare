# ==============================================================================
# SAATHCARE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in your server/ directory (or root) and fill in the values
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Client Application URL (For CORS & Invite Links)
CLIENT_URL=http://localhost:5173

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/saathcare
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/saathcare?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/saathcare

# JWT Authentication Secrets
# Generate secure 64-char strings in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=saathcare_super_secret_access_key_change_in_production_min32chars
JWT_REFRESH_SECRET=saathcare_super_secret_refresh_key_change_in_production_min32chars

# Token Expiry Durations
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Cookie Configuration
# In production, set COOKIE_SECURE=true and COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Background Job Configuration
MISSED_TASK_CRON_SCHEDULE="*/5 * * * *"
MISSED_TASK_JOB_ENABLED=true
